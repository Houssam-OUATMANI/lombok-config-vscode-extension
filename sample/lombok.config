# ==============================================================================
# Sample Lombok Configuration File
# Lombok Sense for VS Code
# ==============================================================================

# Stop bubbling configuration search up the directory hierarchy
config.stopBubbling = true

# Code generation flags (JaCoCo code coverage integration)
lombok.addLombokGeneratedAnnotation = true

# Accessors configuration
lombok.accessors.fluent = true
lombok.accessors.chain = true
lombok.accessors.prefix += m_
lombok.accessors.prefix += _

# Clear previously accumulated list values
clear lombok.accessors.prefix

# EqualsAndHashCode & ToString
lombok.equalsAndHashCode.callSuper = call
lombok.equalsAndHashCode.doNotUseGetters = false
lombok.toString.includeFieldNames = true
lombok.toString.callSuper = warn

# Logging configuration
lombok.log.fieldName = log
lombok.log.fieldIsStatic = true

# Builder & Field Defaults
lombok.builder.className = *Builder
lombok.fieldDefaults.defaultPrivate = true
lombok.fieldDefaults.defaultFinal = false

# Annotations copying
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty

# Flag Usages / Governance
lombok.var.flagUsage = allow
lombok.val.flagUsage = allow
lombok.experimental.flagUsage = warning
lombok.sneakyThrows.flagUsage = warning
