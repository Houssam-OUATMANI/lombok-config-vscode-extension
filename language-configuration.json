{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([a-zA-Z0-9_.-]+)"
}
