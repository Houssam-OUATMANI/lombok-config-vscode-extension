{
  "name": "lombok-sense",
  "displayName": "Lombok Sense",
  "description": "Comprehensive, first-class language support for Lombok configuration (lombok.config): syntax highlighting, smart autocomplete, workspace annotation resolution, hover documentation, diagnostics, quick fixes, and formatting.",
  "version": "0.1.1",
  "publisher": "houssam-ouatmani",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Houssam-OUATMANI/lombok-config-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Houssam-OUATMANI/lombok-config-vscode-extension/issues"
  },
  "homepage": "https://github.com/Houssam-OUATMANI/lombok-config-vscode-extension#readme",
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "lombok",
    "lombok.config",
    "java",
    "intellisense",
    "linter"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:lombok-config"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lombok-config",
        "aliases": [
          "Lombok Config",
          "lombok-config"
        ],
        "filenames": [
          "lombok.config"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lombok-config",
        "scopeName": "source.lombok-config",
        "path": "./syntaxes/lombok-config.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lombokSense.showEffectiveConfig",
        "title": "Lombok: Show Effective Configuration",
        "category": "Lombok Sense"
      },
      {
        "command": "lombokSense.createRootConfig",
        "title": "Lombok: Create Root lombok.config",
        "category": "Lombok Sense"
      }
    ],
    "configuration": {
      "title": "Lombok Sense",
      "properties": {
        "lombokSense.lint.unknownKeys": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "ignore"
          ],
          "default": "warning",
          "description": "Severity level for unknown configuration keys."
        },
        "lombokSense.lint.deprecatedKeys": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "ignore"
          ],
          "default": "warning",
          "description": "Severity level for deprecated configuration keys."
        },
        "lombokSense.lint.invalidValues": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "ignore"
          ],
          "default": "error",
          "description": "Severity level for invalid property values."
        },
        "lombokSense.lint.invalidOperators": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "ignore"
          ],
          "default": "error",
          "description": "Severity level when using '+=' or '-=' on non-list properties."
        },
        "lombokSense.format.spaceAroundOperator": {
          "type": "boolean",
          "default": true,
          "description": "Ensure single space around operators (=, +=, -=) when formatting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build-prod",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build-prod": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap",
    "test": "node --test dist-test/test/**/*.test.js",
    "build-test": "esbuild test/**/*.test.ts --outdir=dist-test/test --format=cjs --platform=node --bundle --external:vscode"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3"
  }
}
